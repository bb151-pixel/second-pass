# Copy this file to .env.local and fill in the values. Never share .env.local.

# From console.anthropic.com -> API Keys. Powers the AI Practice Coach.
ANTHROPIC_API_KEY=

# Comma-separated codes that unlock the AI Practice Coach.
# Make up your own private codes and give one to each paying student.
# Never put real codes in this example file: it's public on GitHub.
PRACTICE_ACCESS_CODES=
